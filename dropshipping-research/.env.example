# YouTube Data API v3 key (Google Cloud Console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Apify API token (Apify console -> Settings -> Integrations)
APIFY_API_TOKEN=

# SerpAPI key (serpapi.com -> Your Account)
SERP_API_KEY=

# Optional: override default Apify actor IDs (see config.py for notes on
# verifying each actor's input schema before a production run)
# TIKTOK_ACTOR_ID=clockworks/tiktok-scraper
# TIKTOK_SHOP_ACTOR_ID=novi/tiktok-shop-scraper
# INSTAGRAM_ACTOR_ID=apify/instagram-scraper
# ALIEXPRESS_ACTOR_ID=thirdwatch/aliexpress-product-scraper

# --- Only needed for `python main.py --push-to-sheets` (daily auto-append) ---
# Path to a Google Cloud service account JSON key with Sheets API enabled.
# See sheets_sync.py module docstring for the one-time setup steps.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Leave blank on the very first --push-to-sheets run: the script creates the
# spreadsheet and logs its ID — paste it here afterwards so future runs
# append to the SAME sheet instead of creating a new one each time.
MAIN_SPREADSHEET_ID=
ALIEXPRESS_SPREADSHEET_ID=
